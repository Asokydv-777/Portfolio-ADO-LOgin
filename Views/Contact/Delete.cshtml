@model Portfolio.Models.ContactMessage

@{
    ViewData["Title"] = "Delete Message";
}

<h2>Delete Message</h2>

<p>Are you sure you want to delete this message from <strong>@Model.Name</strong>?</p>

<blockquote>@Model.Message</blockquote>

<form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit">Yes, Delete</button>
    <a asp-action="List">Cancel</a>
</form>