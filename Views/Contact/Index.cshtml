@{
    ViewData["Title"] = "Contact";
}

<div class="py-4">
    <h2 class="fw-bold mb-4">― Get In Touch</h2>

    <div class="row g-4">
        <div class="col-lg-6">
            <p class="fs-5 mb-4">
                I'm always open to discussing new projects, creative ideas, or opportunities to be part of your vision.
                Feel free to reach out through any of the channels below.
            </p>

            <div class="d-flex flex-column gap-3 fs-5 mt-4">
                <div>
                    <strong class="d-block">Email</strong>
                    <span>ay98127634@gmail.com</span>
                </div>
                <div>
                    <strong class="d-block">GitHub</strong>
                    <a href="https://github.com/alexowallace" target="_blank" class="text-decoration-underline">github.com/alexowallace</a>
                </div>
                <div>
                    <strong class="d-block">LinkedIn</strong>
                    <a href="https://www.linkedin.com/in/ashok-yadav-456a63320" target="_blank" class="text-decoration-underline">linkedin.com/in/ashok-yadav</a>
                </div>
                <div>
                    <strong class="d-block">Location</strong>
                    <span>Suryabinayak, Nepal</span>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card-custom p-4">
                <h4 class="fw-bold mb-3">Send me a message</h4>
                <form>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Name</label>
                        <input type="text" class="form-control" placeholder="Your Name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Email</label>
                        <input type="email" class="form-control" placeholder="Your Email" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Message</label>
                        <textarea class="form-control" rows="4" placeholder="Your Message"></textarea>
                    </div>
                    <button type="submit" class="btn btn-theme w-100 fw-bold py-2">Send Message</button>
                </form>
            </div>
        </div>
    </div>
</div>